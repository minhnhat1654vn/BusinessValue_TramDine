generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Table {
  id           String        @id @default(cuid())
  code         String        @unique
  seats        Int
  zone         String        @default("Phòng chính")
  reservations Reservation[]
}

model Reservation {
  id             String   @id @default(cuid())
  code           String   @unique
  customerName   String
  phone          String
  email          String?
  partySize      Int
  tableId        String
  date           DateTime
  slot           String
  pairing        String   @default("NONE")
  notes          String?
  allergy        String?
  status         String   @default("CONFIRMED")
  depositAmount  Int
  source         String   @default("WEB")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  selectedDishes String?
  table          Table    @relation(fields: [tableId], references: [id])
  survey         Survey?

  @@index([date, slot])
  @@index([tableId, date, slot])
}

model Survey {
  id               String      @id @default(cuid())
  reservationId    String      @unique
  rating           Int
  foodRating       Int         @default(5)
  serviceRating    Int         @default(5)
  ambianceRating   Int         @default(5)
  pairingRating    Int         @default(5)
  comment          String?
  recommend        Boolean     @default(true)
  bonusPointsGiven Int         @default(200)
  createdAt        DateTime    @default(now())
  reservation      Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  partySize Int
  date      DateTime
  slot      String
  position  Int
  status    String   @default("WAITING")
  createdAt DateTime @default(now())

  @@index([date, slot])
}
// Cài đặt chương trình đặt bàn & ngày mở/nghỉ
model BookingSetting {
  id               String   @id @default("default")
  programEnabled   Boolean  @default(true)
  programName      String   @default("Hành trình vị Việt - Tasting Menu 7 món")
  programMode      String   @default("range") // range | specific
  programStartDate String   @default("2027-03-01")
  programEndDate   String   @default("2027-04-30")
  programDays      String   @default("[]") // JSON string: string[]
  closedDates      String   @default("[]") // JSON string: string[]
  allowMonday      Boolean  @default(false)
  notes            String?  @default("Chương trình thực đơn mùa đặc sắc của TRẦM")
  updatedAt        DateTime @updatedAt
}


// ---------- PHÂN HỆ CÔNG THỨC ĐỊNH LƯỢNG (BOM) & NGUYÊN LIỆU ----------

// Danh mục nguyên liệu
model Ingredient {
  id                 String       @id // slug mã nguyên liệu, vd: caviar-lam-dong
  name               String
  unit               String       // "g" | "ml"
  group              String       // "PROTEIN" | "STARCH" | "DAIRY_FAT" | "PRODUCE" | "FRUIT_NUT" | "SEASONING" | "AROMATIC"
  spec               String?      // Quy cách sơ chế / đóng gói
  defaultImportPrice Int          @default(0) // Đơn giá nhập VND (trên kg hoặc lít)
  currentStock       Float        @default(1000) // Tồn kho thực tế (g hoặc ml)
  minStock           Float        @default(200)  // Ngưỡng cảnh báo tồn kho tối thiểu
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  lines              RecipeLine[]
}

// Công thức món ăn (7 món Tasting)
model DishRecipe {
  id        String          @id @default(cuid())
  dishIndex Int             @unique // 1..7
  dishName  String
  portion   String          @default("1 khách")
  method    String          @default("Chế biến thủ công")
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  variants  RecipeVariant[]
}

// Biến thể / Tùy chọn của món (vd: Tiêu chuẩn, Chiên giòn, Ít ngọt, ...)
model RecipeVariant {
  id         String       @id @default(cuid())
  recipeId   String
  optionId   String       // "std", "crispy_fried", "mild_wine", ...
  optionName String
  isDefault  Boolean      @default(true)
  note       String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  recipe     DishRecipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  lines      RecipeLine[]

  @@unique([recipeId, optionId])
}

// Dòng định lượng nguyên liệu cho từng biến thể
model RecipeLine {
  id           String        @id @default(cuid())
  variantId    String
  ingredientId String
  qtyPerGuest  Float         // Định lượng cho 1 khách
  unit         String        // "g" | "ml"
  prepNote     String?       // Ghi chú chuẩn bị / sơ chế
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  variant      RecipeVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  ingredient   Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([variantId, ingredientId])
}
