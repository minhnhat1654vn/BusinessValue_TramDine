generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Table {
  id           String        @id @default(cuid())
  code         String        @unique
  seats        Int
  zone         String        @default("Phòng chính")
  reservations Reservation[]
}

model Reservation {
  id             String   @id @default(cuid())
  code           String   @unique
  customerName   String
  phone          String
  email          String?
  partySize      Int
  tableId        String
  date           DateTime
  slot           String
  pairing        String   @default("NONE")
  notes          String?
  allergy        String?
  status         String   @default("CONFIRMED")
  depositAmount  Int
  source         String   @default("WEB")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  selectedDishes String?
  table          Table    @relation(fields: [tableId], references: [id])
  survey         Survey?

  @@index([date, slot])
  @@index([tableId, date, slot])
}

model Survey {
  id               String      @id @default(cuid())
  reservationId    String      @unique
  rating           Int
  foodRating       Int         @default(5)
  serviceRating    Int         @default(5)
  ambianceRating   Int         @default(5)
  pairingRating    Int         @default(5)
  comment          String?
  recommend        Boolean     @default(true)
  bonusPointsGiven Int         @default(200)
  createdAt        DateTime    @default(now())
  reservation      Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  partySize Int
  date      DateTime
  slot      String
  position  Int
  status    String   @default("WAITING")
  createdAt DateTime @default(now())

  @@index([date, slot])
}
// Cài đặt chương trình đặt bàn & ngày mở/nghỉ
model BookingSetting {
  id               String   @id @default("default")
  programEnabled   Boolean  @default(true)
  programName      String   @default("Hành trình vị Việt - Tasting Menu 7 món")
  programMode      String   @default("range") // range | specific
  programStartDate String   @default("2026-10-18")
  programEndDate   String   @default("2026-11-30")
  programDays      String   @default("[]") // JSON string: string[]
  closedDates      String   @default("[]") // JSON string: string[]
  allowMonday      Boolean  @default(false)
  notes            String?  @default("Chương trình thực đơn mùa đặc sắc của TRẦM")
  updatedAt        DateTime @updatedAt
}
